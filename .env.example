# Copy this file to .env on the server. Never commit the real .env file.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
SESSION_SECURE=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rnc
DB_USER=rnc_app
DB_PASSWORD=replace-with-a-long-random-password

# Use "smtp" in production. "mail" keeps local PHP/Mailpit compatibility.
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_AUTH=true
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=replace-with-your-smtp-password
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=R&C Printing Services
